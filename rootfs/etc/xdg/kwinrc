[Desktops]
Number=1
Rows=1

# No hot corners: Windows doesn't have them.
[ElectricBorders]
TopLeft=None

[Effect-overview]
BorderActivate=9

# Windows 11-style titlebar (Klassy, see /etc/xdg/klassy/klassyrc): app icon on the left;
# minimize, maximize, close on the right.
[org.kde.kdecoration2]
ButtonsOnLeft=M
ButtonsOnRight=IAX
library=org.kde.klassy
theme=Klassy

# Alt+Tab: Shades' Windows 11-style switcher (/usr/share/kwin/tabbox/shades).
[TabBox]
LayoutName=shades
